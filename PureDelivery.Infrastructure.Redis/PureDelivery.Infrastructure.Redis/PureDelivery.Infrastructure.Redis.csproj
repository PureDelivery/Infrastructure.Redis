    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PackageId>PureDelivery.Infrastructure.Redis</PackageId>
	<PackageVersion>1.0.0</PackageVersion>
	<Authors>PureDelivery Team</Authors>
